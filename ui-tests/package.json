{
  "name": "ui-tests",
  "version": "1.0.0",
  "description": "Playwright UI automation tests — demo shop + car rental app",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:q1": "playwright test tests/q1-invalid-login.spec.js",
    "test:q2": "playwright test tests/q2-register-add-cart.spec.js",
    "test:q3": "playwright test tests/q3-e2e-checkout.spec.js",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report playwright-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": ["playwright", "automation", "e2e"],
  "author": "Atef Ahabab",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "allure-playwright": "^3.13.0",
    "allure-commandline": "^2.30.0"
  }
}
